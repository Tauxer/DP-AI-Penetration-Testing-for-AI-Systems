# Copia a .env. Nunca subas el .env al repositorio.

# Juez LLM — evalúa los casos que las reglas no cierran.
# OPENAI_API_KEY=sk-...   Déjala comentada si no la usas: una variable VACÍA aquí pisa la del proyecto objetivo y rompe su agente.
RT_MODELO_JUEZ=gpt-4.1

# Canario: token que debes pegar dentro del system prompt del proyecto objetivo.
# Si aparece en una respuesta del agente, el prompt se filtró.
RT_CANARY=RT-CANARY-9F2A7C

# Token de un objetivo de tipo http, referenciado desde targets.yaml por su
# nombre de variable (env_token), nunca por su valor.
# RT_TOKEN_API_PRODUCCION=
