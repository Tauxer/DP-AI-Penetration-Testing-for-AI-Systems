# Copia este archivo a backend/.env y rellénalo. Nunca lo subas al repositorio.

# Clave de OpenAI para el ADVERSARIO y el JUEZ de DeepTeam (y el juez opcional de
# Red Turing). El agente que se prueba usa su propia clave por su cuenta.
OPENAI_API_KEY=

# Tokens de los objetivos HTTP. En la sección Objetivos se anota solo el NOMBRE
# de la variable (p. ej. RT_TOKEN_ASISTENTE_VENTAS); el valor va aquí.
# RT_TOKEN_ASISTENTE_VENTAS=

# Canario de Red Turing: el mismo token sembrado en el system prompt del agente.
RT_CANARY=RT-CANARY-9F2A7C
